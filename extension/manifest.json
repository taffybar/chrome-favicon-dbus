{
  "manifest_version": 3,
  "name": "Chrome Favicon D-Bus",
  "description": "Publishes active tab metadata (title/url/favicon) to a local D-Bus daemon.",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "permissions": ["tabs", "windows"],
  "host_permissions": [
    "http://127.0.0.1:38933/*",
    "http://localhost:38933/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
